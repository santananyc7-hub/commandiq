# ── CommandIQ environment ─────────────────────────────────────────────────
# Copy to .env.local and fill in. Nothing here is required to run demo mode.

# AI CFO ("Ask CommandIQ"). Without a key, the AI CFO falls back to the
# deterministic on-device reasoner (no hallucination, uses local metrics).
ANTHROPIC_API_KEY=

# ── QuickBooks Online (V1 live integration) ───────────────────────────────
# Create an app at https://developer.intuit.com and paste the keys here.
# Leave blank to run entirely in demo mode.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3005/api/integrations/quickbooks/callback
# "sandbox" while developing, "production" when live.
QUICKBOOKS_ENVIRONMENT=sandbox
